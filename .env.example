DATABASE_URL=postgres://postgres:postgres@localhost:5432/labboard
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Optional — only needed if you want email notifications for new initiatives/updates.
# Leave unset to disable email entirely (sign-in still works).
RESEND_API_KEY=
EMAIL_FROM=

# Optional — restricts sign-in to a single email domain (e.g. yourcompany.com)
ALLOWED_EMAIL_DOMAIN=

# Comma-separated emails that get auto-promoted to "tech" role on first sign-in
TECH_TEAM_EMAILS=
